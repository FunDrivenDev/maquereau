{
  "nodeModulesDir": "auto",
  "minimumDependencyAge": "P7D",
  "tasks": {
    "web:dev": "vite",
    "web:build": "vite build",
    "web:check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "tauri": "tauri"
  },
  "imports": {
    "@sveltejs/vite-plugin-svelte": "npm:@sveltejs/vite-plugin-svelte@^7.3.0",
    "@tauri-apps/api": "npm:@tauri-apps/api@^2.11.1",
    "@tauri-apps/api/": "npm:/@tauri-apps/api@^2.11.1/",
    "@tauri-apps/cli": "npm:@tauri-apps/cli@^2.11.5",
    "dompurify": "npm:dompurify@^3.4.15",
    "highlight.js": "npm:highlight.js@^11.12.0",
    "highlight.js/": "npm:/highlight.js@^11.12.0/",
    "marked": "npm:marked@^18.0.14",
    "marked-highlight": "npm:marked-highlight@^2.2.4",
    "svelte": "npm:svelte@^5.57.1",
    "svelte/": "npm:/svelte@^5.57.1/",
    "svelte-check": "npm:svelte-check@^4.7.6",
    "typescript": "npm:typescript@^7.0.2",
    "vite": "npm:vite@^8.3.0"
  },
  "fmt": {
    "lineWidth": 110,
    "include": [
      "src/",
      "vite.config.ts",
      "svelte.config.js",
      "index.html",
      "deno.json",
      "tsconfig.json"
    ]
  },
  "lint": {
    "include": [
      "src/",
      "vite.config.ts"
    ]
  }
}
